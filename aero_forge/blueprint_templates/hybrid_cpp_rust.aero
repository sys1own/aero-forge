project: hybrid_cpp_rust_project
architecture: hybrid_cpp_rust
toolchains:
  - rust
  - cpp
  - cargo
manifest:
  - path: Cargo.toml
    lang: toml
    purpose: Rust package manifest
  - path: build.rs
    lang: rust
    purpose: Compile and statically link the C++ object
  - path: src/main.rs
    lang: rust
    purpose: Rust CLI binary
  - path: src/cpp_core/native.cpp
    lang: cpp
    purpose: C-ABI math source
  - path: tests/test_hybrid_cpp_rust.rs
    lang: rust
    purpose: Rust integration test
  - path: README.md
    lang: markdown
    purpose: Project README
contracts:
  - name: <main_function>
    signature: "def <main_function>(x: list[float], scalar: float) -> list[float]"
    language: rust/cpp
    purpose: Rust/C++ C-ABI entry point
output_dir: dist
prompt: "Build a native Rust CLI that links an extern C C++ math module via build.rs."
constraints: "Use build.rs with g++ to compile src/cpp_core/native.cpp and link the resulting static archive to the Rust binary."
llm:
  provider: none
  model: null
